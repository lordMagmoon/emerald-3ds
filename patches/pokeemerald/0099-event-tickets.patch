diff --git a/src/event_tickets.c b/src/event_tickets.c
new file mode 100644
index 0000000..c919cf2
--- /dev/null
+++ b/src/event_tickets.c
@@ -0,0 +1,91 @@
+/* Emerald 3DS: the event islands' tickets without the Mystery Gift
+ * (OPTIONS > POKEDEX > EVENT TICKETS).
+ *
+ * After the Hall of Fame, the MYSTERY GIFT man upstairs in a POKéMON CENTER
+ * hands over each ticket the player has earned (data/scripts/cable_club.inc):
+ *
+ *   AURORA TICKET (DEOXYS, BIRTH ISLAND)    STEVEN beaten at METEOR FALLS
+ *   EON TICKET (the LATI the player did     four GYM LEADERS beaten again
+ *     not choose, SOUTHERN ISLAND)
+ *   OLD SEA MAP (MEW, FARAWAY ISLAND)       all eight GYM LEADERS beaten again
+ *   MYSTIC TICKET (LUGIA and HO-OH,         the POKéMON LEAGUE won a second time
+ *     NAVEL ROCK)
+ *
+ * The conditions read what the save already keeps (a rematch sets its
+ * trainer's flag, the Hall of Fame counts its entries), so a save that met
+ * one before the option existed gets it too. A ticket is never given twice:
+ * once the ferry to its island is enabled, by this or by a real Mystery
+ * Gift, it is done. */
+#include "global.h"
+#include "event_data.h"
+#include "event_tickets.h"
+#include "item.h"
+#include "overworld.h"
+#include "constants/items.h"
+#include "constants/opponents.h"
+#include "3ds_extras.h"
+
+static const u16 sGymLeaderRematches[] =
+{
+    TRAINER_ROXANNE_2, TRAINER_BRAWLY_2, TRAINER_WATTSON_2, TRAINER_FLANNERY_2,
+    TRAINER_NORMAN_2, TRAINER_WINONA_2, TRAINER_TATE_AND_LIZA_2, TRAINER_JUAN_2,
+};
+
+static u32 GymLeadersBeatenAgain(void)
+{
+    u32 i, count = 0;
+
+    /* A rematch sets the flag of the trainer it was against: the leader's
+     * first rematch is TRAINER_*_2, and the later ones need it beaten. */
+    for (i = 0; i < ARRAY_COUNT(sGymLeaderRematches); i++)
+    {
+        if (FlagGet(TRAINER_FLAGS_START + sGymLeaderRematches[i]))
+            count++;
+    }
+    return count;
+}
+
+static bool32 Earned(u16 item)
+{
+    switch (item)
+    {
+    case ITEM_AURORA_TICKET:
+        return FlagGet(FLAG_DEFEATED_METEOR_FALLS_STEVEN);
+    case ITEM_EON_TICKET:
+        return GymLeadersBeatenAgain() >= 4;
+    case ITEM_OLD_SEA_MAP:
+        return GymLeadersBeatenAgain() >= ARRAY_COUNT(sGymLeaderRematches);
+    case ITEM_MYSTIC_TICKET:
+        return GetGameStat(GAME_STAT_ENTERED_HOF) >= 2;
+    }
+    return FALSE;
+}
+
+static const struct
+{
+    u16 item;
+    u16 shipFlag;
+} sTickets[] =
+{
+    {ITEM_AURORA_TICKET, FLAG_ENABLE_SHIP_BIRTH_ISLAND},
+    {ITEM_EON_TICKET,    FLAG_ENABLE_SHIP_SOUTHERN_ISLAND},
+    {ITEM_OLD_SEA_MAP,   FLAG_ENABLE_SHIP_FARAWAY_ISLAND},
+    {ITEM_MYSTIC_TICKET, FLAG_ENABLE_SHIP_NAVEL_ROCK},
+};
+
+/* The next ticket the player has earned and not had, or ITEM_NONE. */
+u16 CtrEventTicket_Due(void)
+{
+    u32 i;
+
+    if (!CtrExtras_Get("event_tickets") || !FlagGet(FLAG_SYS_GAME_CLEAR))
+        return ITEM_NONE;
+    for (i = 0; i < ARRAY_COUNT(sTickets); i++)
+    {
+        if (FlagGet(sTickets[i].shipFlag) || CheckBagHasItem(sTickets[i].item, 1))
+            continue;
+        if (Earned(sTickets[i].item))
+            return sTickets[i].item;
+    }
+    return ITEM_NONE;
+}
