+@ Emerald 3DS: STEVEN hands over the AURORA TICKET once he is beaten, now
+@ or any later time the player talks to him (src/event_tickets.c).
+MeteorFalls_StevensCave_EventScript_CtrAuroraTicket::
+	specialvar VAR_RESULT, CtrEventTicket_Due
+	goto_if_ne VAR_RESULT, ITEM_AURORA_TICKET, MeteorFalls_StevensCave_EventScript_CtrTicketDone
+	msgbox MeteorFalls_StevensCave_Text_CtrTakeThisTicket, MSGBOX_DEFAULT
+	giveitem ITEM_AURORA_TICKET
+	goto_if_eq VAR_0x8007, FALSE, MeteorFalls_StevensCave_EventScript_CtrTicketDone
+	setflag FLAG_ENABLE_SHIP_BIRTH_ISLAND
+	setflag FLAG_RECEIVED_AURORA_TICKET
+	msgbox MeteorFalls_StevensCave_Text_CtrShowItAtLilycove, MSGBOX_DEFAULT
+MeteorFalls_StevensCave_EventScript_CtrTicketDone::
