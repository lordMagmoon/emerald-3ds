+@ Emerald 3DS: the event islands' tickets the player has earned in the game
+@ (src/event_tickets.c), one after another.
+CableClub_EventScript_CtrEventTicket::
+	lock
+	faceplayer
+CableClub_EventScript_CtrEventTicketNext::
+	specialvar VAR_RESULT, CtrEventTicket_Due
+	goto_if_eq VAR_RESULT, ITEM_AURORA_TICKET, CableClub_EventScript_CtrAuroraTicket
+	goto_if_eq VAR_RESULT, ITEM_EON_TICKET, CableClub_EventScript_CtrEonTicket
+	goto_if_eq VAR_RESULT, ITEM_OLD_SEA_MAP, CableClub_EventScript_CtrOldSeaMap
+	goto_if_eq VAR_RESULT, ITEM_MYSTIC_TICKET, CableClub_EventScript_CtrMysticTicket
+	release
+	end
+
+CableClub_EventScript_CtrAuroraTicket::
+	msgbox CableClub_Text_CtrTicketFromSteven, MSGBOX_DEFAULT
+	giveitem ITEM_AURORA_TICKET
+	goto_if_eq VAR_0x8007, FALSE, CableClub_EventScript_CtrTicketEnd
+	setflag FLAG_ENABLE_SHIP_BIRTH_ISLAND
+	setflag FLAG_RECEIVED_AURORA_TICKET
+	goto CableClub_EventScript_CtrTicketGiven
+
+CableClub_EventScript_CtrEonTicket::
+	msgbox CableClub_Text_CtrTicketFromGymLeaders, MSGBOX_DEFAULT
+	giveitem ITEM_EON_TICKET
+	goto_if_eq VAR_0x8007, FALSE, CableClub_EventScript_CtrTicketEnd
+	setflag FLAG_ENABLE_SHIP_SOUTHERN_ISLAND
+	goto CableClub_EventScript_CtrTicketGiven
+
+CableClub_EventScript_CtrOldSeaMap::
+	msgbox CableClub_Text_CtrTicketFromGymLeaders, MSGBOX_DEFAULT
+	giveitem ITEM_OLD_SEA_MAP
+	goto_if_eq VAR_0x8007, FALSE, CableClub_EventScript_CtrTicketEnd
+	setflag FLAG_ENABLE_SHIP_FARAWAY_ISLAND
+	setflag FLAG_RECEIVED_OLD_SEA_MAP
+	goto CableClub_EventScript_CtrTicketGiven
+
+CableClub_EventScript_CtrMysticTicket::
+	msgbox CableClub_Text_CtrTicketFromLeague, MSGBOX_DEFAULT
+	giveitem ITEM_MYSTIC_TICKET
+	goto_if_eq VAR_0x8007, FALSE, CableClub_EventScript_CtrTicketEnd
+	setflag FLAG_ENABLE_SHIP_NAVEL_ROCK
+	setflag FLAG_RECEIVED_MYSTIC_TICKET
+	goto CableClub_EventScript_CtrTicketGiven
+
+CableClub_EventScript_CtrTicketGiven::
+	msgbox MysteryGift_Text_TryUsingItAtLilycovePort, MSGBOX_DEFAULT
+	goto CableClub_EventScript_CtrEventTicketNext
+
+CableClub_EventScript_CtrTicketEnd::
+	release
+	end
+
+CableClub_Text_CtrTicketFromSteven::
+	.string "Thank you for using the MYSTERY\n"
+	.string "GIFT System.\p"
+	.string "You must be {PLAYER}.\n"
+	.string "STEVEN left this here for you.$"
+
+CableClub_Text_CtrTicketFromGymLeaders::
