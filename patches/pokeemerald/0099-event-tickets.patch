+#ifndef GUARD_EVENT_TICKETS_H
+#define GUARD_EVENT_TICKETS_H
+
+/* Emerald 3DS: the event islands' tickets earned in the game
+ * (src/event_tickets.c, OPTIONS > POKEDEX > EVENT TICKETS). */
+u16 CtrEventTicket_Due(void);
