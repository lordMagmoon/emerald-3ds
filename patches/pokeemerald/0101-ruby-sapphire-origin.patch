@@ -467,6 +467,24 @@ static void CreateWildMon(u16 species, u8 level)
 #define TRY_GET_ABILITY_INFLUENCED_WILD_MON_INDEX(wildPokemon, type, ability, ptr, count) TryGetAbilityInfluencedWildMonIndex(wildPokemon, type, ability, ptr)
 #endif
 
+/* Emerald 3DS: a Ruby/Sapphire Pokemon (OPTIONS > POKEDEX > RUBY/SAPPHIRE) is
+ * met in the game it comes from. Its map, slot and level are that game's, and
+ * the slot, the level and the personality come from the random calls in the
+ * same order, so a save checker such as PKHeX finds the encounter there. */
+static void SetWildMonOrigin(struct Pokemon *mon, bool32 water, u32 slot, u16 tableSpecies)
+{
+    u32 origin = CtrEncounters_RsOrigin(gSaveBlock1Ptr->location.mapGroup, gSaveBlock1Ptr->location.mapNum,
+                                        water, slot, tableSpecies);
+    u8 game;
+
+    if (origin == 0 || WILD_SPECIES(tableSpecies) != tableSpecies)
+        return;
+    if (origin == CTR_RS_EITHER)
+        origin = (GetMonData(mon, MON_DATA_PERSONALITY) >> 16) & 1 ? CTR_RS_RUBY : CTR_RS_SAPPHIRE;
+    game = origin;
+    SetMonData(mon, MON_DATA_MET_GAME, &game);
+}
+
