+#ifdef PLATFORM_3DS
+// The battler's BW picture, if the player has one for it (3ds_bw_mons.h).
+static void CtrBwMonsLoaded(u8 battler, u16 species, u32 personality, u32 shinyPersonality, u32 otId,
+                            bool8 back, bool8 deoxysForm)
+{
+    u8 form = 0;
+
+    if (species == SPECIES_UNOWN)
+        form = GET_UNOWN_LETTER(personality);
+    else if (species == SPECIES_CASTFORM)
+        form = gBattleMonForms[battler];
+    else if (species == SPECIES_DEOXYS)
+        form = deoxysForm;
+    CtrBwMons_Loaded(battler, species, form,
+                     GetGenderFromSpeciesAndPersonality(species, personality) == MON_FEMALE,
+                     IsShinyOtIdPersonality(otId, shinyPersonality), back,
+                     gBattleSpritesDataPtr->battlerData[battler].transformSpecies != SPECIES_NONE);
+}
+#endif
